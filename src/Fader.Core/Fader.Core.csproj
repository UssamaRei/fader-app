<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Targets net10.0-windows to match VS 2026 Insiders runtime.
      The Windows TFM (10.0.19041.0 = Windows 10 2004 minimum) is required for
      Windows Runtime type projections used by NAudio's WASAPI bindings.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Fader.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- NAudio for WASAPI / CoreAudio COM interop -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- DI abstractions (no container — container lives in the app host) -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.7" />
  </ItemGroup>

</Project>
