<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fader.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fader.Pages"
    xmlns:vm="using:Fader.ViewModels"
    xmlns:models="using:Fader.Core.Models"
    xmlns:controls="using:Fader.Controls"
    xmlns:converters="using:Fader.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Spacing="0" Padding="24,16,24,32">

            <!-- ═══ Header ═══════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Badge -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Status"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Animated status dot -->
                        <Ellipse x:Name="StatusDot"
                                 Width="8" Height="8"
                                 Fill="{StaticResource FaderAccentBrush}"
                                 VerticalAlignment="Center">
                            <Ellipse.RenderTransform>
                                <ScaleTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock x:Name="StatusLabel"
                                   Text="{Binding StatusText}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Refresh audio sessions">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>

                    <Button x:Name="SettingsButton"
                            Click="SettingsButton_Click"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══ Active Sessions Section ══════════════════════════════════ -->
            <TextBlock Text="Active Audio Sessions"
                       Style="{StaticResource SectionHeaderStyle}"
                       Margin="0,0,0,12" />

            <!-- Loading indicator -->
            <ProgressBar IsIndeterminate="{Binding IsRefreshing}"
                         Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibilityConverter}}"
                         Margin="0,0,0,12" />

            <!-- Empty state -->
            <Border x:Name="EmptyState"
                    Style="{StaticResource EmptyStateBorderStyle}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE767;" FontSize="32"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="No active audio sessions"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Text="Play something in an app to see it here"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>

            <!-- Session cards list -->
            <ItemsControl x:Name="SessionsList"
                          ItemsSource="{Binding Sessions}"
                          Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:AppSessionCard
                            Session="{Binding}"
                            Margin="0,0,0,8" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- ═══ Settings Summary ════════════════════════════════════════ -->
            <TextBlock Text="Quick Settings"
                       Style="{StaticResource SectionHeaderStyle}"
                       Margin="0,28,0,12" />

            <Border Style="{StaticResource CardBorderStyle}">
                <Grid Padding="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <!-- Duck Volume -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                        <TextBlock Text="Duck Volume"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="20%"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>

                    <!-- Fade Duration -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                        <TextBlock Text="Fade Duration"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="350 ms"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>

                    <!-- Restore Delay -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Restore Delay"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="800 ms"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>

                    <!-- Min Playback -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Min Playback"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="800 ms"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
