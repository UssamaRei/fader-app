<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fader"
    xmlns:pages="using:Fader.Pages"
    xmlns:tb="using:H.NotifyIcon">

    <!--
        RootGrid: fills the entire window content area.
        Background is intentionally transparent so Mica shows through.
        On Windows 10 fallback, MainWindow.xaml.cs sets the background programmatically.
    -->
    <Grid x:Name="RootGrid" Background="Transparent">
        
        <Grid.RowDefinitions>
            <!-- Custom drag region for title bar -->
            <RowDefinition Height="48" />
            <!-- Main content area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- System Tray Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Fader"
                        IconSource="/Assets/AppIcon.ico"
                        DoubleClickCommand="{x:Bind ShowWindowCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open Fader" Command="{x:Bind ShowWindowCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE1A5;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Click="MenuExit_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE106;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- ═══ Custom Title Bar ════════════════════════════════════════════ -->
        <Grid Grid.Row="0"
              x:Name="TitleBarGrid"
              IsHitTestVisible="True">

            <Grid.ColumnDefinitions>
                <!-- Left padding for window caption buttons -->
                <ColumnDefinition Width="16" />
                <!-- App icon -->
                <ColumnDefinition Width="28" />
                <!-- App title -->
                <ColumnDefinition Width="*" />
                <!-- Settings Button -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App icon in title bar -->
            <Image Grid.Column="1"
                   Source="Assets/AppIcon.png"
                   Width="20" Height="20"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False" />

            <!-- App name -->
            <TextBlock Grid.Column="2"
                       Text="Fader"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       Style="{StaticResource TitleBarTextStyle}"
                       IsHitTestVisible="False" />
                       
            <!-- Settings Button -->
            <!-- We dynamically add RightInset to TitleBarGrid in code-behind to avoid system buttons -->
            <AppBarButton Grid.Column="3" 
                          x:Name="SettingsButton"
                          Icon="Setting"
                          Width="48" Height="48"
                          Click="SettingsButton_Click"
                          ToolTipService.ToolTip="Settings" />
        </Grid>

        <!-- ═══ Page Content ════════════════════════════════════════════════ -->
        <Frame x:Name="RootFrame" Grid.Row="1" />

    </Grid>
</Window>
